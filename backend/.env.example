JWT_SECRET=pizza_negocio_jwt_secreto_cambiar_en_produccion
JWT_EXPIRES_IN=8h

# Docker Compose usa DB_HOST=postgres (sobrescrito en docker-compose.yml)
# Si corres el backend local con npm run dev, usa localhost
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventario
DB_USER=inventario_user
DB_PASSWORD=inventario_password
PORT=3000

# Meta WhatsApp Cloud API webhook and outbound messages
WHATSAPP_VERIFY_TOKEN=define-un-token-largo-aleatorio
META_APP_SECRET=secreto-de-la-app-de-meta
WHATSAPP_ACCESS_TOKEN=token-de-acceso-de-whatsapp
WHATSAPP_PHONE_NUMBER_ID=id-del-numero-de-whatsapp
WHATSAPP_GRAPH_API_VERSION=v25.0

# Optional: enable Gemini for questions outside menu and availability
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
